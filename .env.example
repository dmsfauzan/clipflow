APP_NAME=Clipflow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=clipflow
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=9000

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ==== Clipflow ====
CLIPFLOW_TIMEZONE=Asia/Jakarta
CLIPFLOW_MAX_UPLOAD_BYTES=2147483648
CLIPFLOW_MAX_DURATION_SECONDS=7200
CLIPFLOW_FFMPEG_BINARY=ffmpeg
CLIPFLOW_FFPROBE_BINARY=ffprobe
CLIPFLOW_PYTHON_BINARY=python
CLIPFLOW_YTDLP_BINARY=yt-dlp
CLIPFLOW_DOWNLOAD_MAX_HEIGHT=1080
CLIPFLOW_DOWNLOAD_TIMEOUT=3600
CLIPFLOW_DOWNLOAD_ALLOWED_HOSTS=
CLIPFLOW_YTDLP_COOKIES=
CLIPFLOW_IMPORT_MAX_CONCURRENT=2
CLIPFLOW_DOWNLOAD_DNS_CHECK=true
CLIPFLOW_WHISPER_MODEL=small
CLIPFLOW_WHISPER_CPU_THREADS=4
CLIPFLOW_TRANSCRIPTION_LANGUAGE=id
CLIPFLOW_RENDER_WIDTH=720
CLIPFLOW_RENDER_HEIGHT=1280
CLIPFLOW_DAILY_LIMIT=30
CLIPFLOW_SLOT_START=08:00
CLIPFLOW_SLOT_END=22:30
CLIPFLOW_SLOT_INTERVAL_MINUTES=30
CLIPFLOW_AUTO_SCHEDULE=false
CLIPFLOW_DEFAULT_PRIVACY=private
CLIPFLOW_OVERDUE_GRACE_MINUTES=120

# Transkripsi & AI
# Alternatif lokal (dipakai bila CLIPFLOW_AI_DRIVER=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=600

# Seleksi klip AI: driver "ollama" atau "9router" (OpenAI-compatible)
CLIPFLOW_AI_DRIVER=ollama
CLIPFLOW_AI_BASE_URL=http://127.0.0.1:11434
CLIPFLOW_AI_MODEL=llama3.1:8b
# Contoh 9router: CLIPFLOW_AI_DRIVER=9router, CLIPFLOW_AI_BASE_URL=http://localhost:20128/v1,
# CLIPFLOW_AI_MODEL=assist, CLIPFLOW_AI_API_KEY=<kunci dari dashboard 9router>
CLIPFLOW_AI_API_KEY=
CLIPFLOW_AI_RESPONSE_FORMAT=true
CLIPFLOW_AI_TIMEOUT=600

# Notifikasi Telegram (opsional)
CLIPFLOW_TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Kuota YouTube Data API (unit/hari dan biaya per upload)
YOUTUBE_DAILY_QUOTA_UNITS=10000
YOUTUBE_UPLOAD_COST_UNITS=1600
YOUTUBE_QUOTA_RESERVE_UNITS=200

# YouTube OAuth (kosong = fitur koneksi YouTube dinonaktifkan sampai diisi)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/channels/youtube/callback"

# Akun pemilik untuk seeder lokal (tidak dipakai di produksi)
CLIPFLOW_OWNER_EMAIL=owner@clipflow.test
CLIPFLOW_OWNER_PASSWORD=password
